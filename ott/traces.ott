% Rec language, trace logic and proof calculus from
% D. Gurov and R. Hähnle, "An Expressive Trace Logic for Recursive Programs"
% (arXiv:2411.13125). Exported to HOL4 with: ott -i traces.ott -o tracesScript.sml

embed
{{ hol
open integerTheory stringTheory pred_setTheory listTheory alistTheory combinTheory;
}}

metavar n ::=
  {{ lex numeral }}
  {{ com integer constant }}
  {{ hol int }}
metavar x ::=
  {{ lex alphanum }}
  {{ com program variable name }}
  {{ hol string }}
metavar X ::=
  {{ lex alphanum }}
  {{ com recursion variable name }}
  {{ hol string }}
metavar Q ::=
  {{ lex alphanum }}
  {{ com relation name }}
  {{ hol string }}
metavar m ::=
  {{ lex alphanum }}
  {{ com procedure name }}
  {{ hol string }}
metavar Y ::=
  {{ lex alphanum }}
  {{ com statement variable name }}
  {{ hol string }}

grammar
v :: v_ ::=
  {{ com boolean value }}
  {{ hol bool }}
| tt :: M :: tt
  {{ hol T }}
| ff :: M :: ff
  {{ hol F }}

a :: a_ ::=
  {{ com arithmetic expressions }}
| n :: :: num
| x :: :: var
| - a :: :: uminus
| a1 + a2 :: :: plus
| a1 - a2 :: :: minus
| a1 * a2 :: :: times
| ( a ) :: S :: paren
  {{ hol [[a]] }}

b :: b_ ::=
  {{ com Boolean expressions }}
| true :: :: true
| false :: :: false
| a1 = a2 :: :: eq
| a1 <= a2 :: :: leq
| ~ b :: :: neg
| b1 /\ b2 :: :: and
| ( b ) :: S :: paren
  {{ hol [[b]] }}

S :: S_ ::=
  {{ com statements }}
| skip :: :: skip
| x := a :: :: assign
| S1 ; S2 :: :: seq
| if b then S1 else S2 :: :: ifelse
| m ( ) :: :: call
| Y :: :: var
  {{ com statement variable }}
| ( S ) :: S :: paren
  {{ hol [[S]] }}
| S [ G ] :: M :: subst_calls
  {{ com replace each call $m()$ with $\mathsf{skip};Y_m$ for $Y_m$ in the domain of $\Gamma$ }}
  {{ hol (subst_calls (G_dom [[G]]) [[S]]) }}
  {{ tex [[S]][\mathsf{skip};Y_{m'}/m'()]_{Y_{m'} \in \mathrm{dom}([[G]])} }}

s :: s_ ::=
  {{ com program states }}
  {{ hol (string -> int) }}
| s [ x |-> n ] :: M :: update
  {{ hol (([[x]] =+ [[n]]) [[s]]) }}

c :: c_ ::=
  {{ com configurations }}
| << S , s >> :: :: tuple
| s :: :: state

t :: t_ ::=
  {{ com finite traces }}
  {{ hol ((string -> int) list) }}
| s :: M :: one
  {{ hol [ [[s]] ] }}
| s . t :: M :: cons
  {{ hol ([[s]] :: [[t]]) }}
  {{ tex [[s]] \cdot [[t]] }}

p :: p_ ::=
  {{ com state formulas }}
| b :: :: b

R :: R_ ::=
  {{ com binary relation symbols }}
| Id :: :: Id
  {{ com identity relation }}
| Sb [ a , x ] :: :: Sb
  {{ com update relation }}
  {{ tex \widehat{\mathsf{Sb} }^{[[a]]}_{[[x]]} }}
| Q :: :: other
  {{ com other relation }}

f {{ tex \phi }} :: f_ ::=
  {{ com trace formulas }}
| p :: :: state
| R :: :: rel
| X :: :: recvar
| f1 /\ f2 :: :: and
| f1 \/ f2 :: :: or
| f1 ^ f2 :: :: chop
| mu X . f :: :: mu (+ bind X in f +)
| ( f ) :: S :: paren
  {{ hol [[f]] }}
| f [ f' / X ] :: M :: subst
  {{ hol (subst_f [[f']] [[X]] [[f]]) }}

G {{ tex \Gamma }} :: G_ ::=
  {{ com sets of statement variable judgments }}
  {{ hol ((string # f) set) }}
| empty :: M :: empty
  {{ hol EMPTY }}
  {{ tex \emptyset }}
| G , Y : f :: M :: insert
  {{ hol (([[Y]],[[f]]) INSERT [[G]]) }}

Tab {{ tex T }} :: Tab_ ::=
  {{ com procedure tables (lists of declarations, first match counts) }}
  {{ hol ((string # S) list) }}
| m { S } Tab :: M :: cons
  {{ hol (([[m]],[[S]]) :: [[Tab]]) }}

E :: E_ ::=
  {{ com entailment oracles on trace formulas }}
  {{ hol (f -> f -> bool) }}
| E E' :: M :: dummy
  {{ hol [[E]] }}

terminals :: terminals_ ::=
| ^ :: :: chop {{ tex \smallfrown }}
| mu :: :: mu {{ tex \mu }}
| /\ :: :: and {{ tex \land }}
| \/ :: :: or {{ tex \lor }}
| ~ :: :: neg {{ tex \lnot }}
| <= :: :: leq {{ tex \leq }}
| => :: :: rightarrow {{ tex \Rightarrow }}
| << :: :: langle {{ tex \langle }}
| >> :: :: rangle {{ tex \rangle }}
| |-> :: :: mapsto {{ tex \mapsto }}
| in :: :: in {{ tex \in }}
| |- :: :: vdash {{ tex \vdash }}
| |= :: :: models {{ tex \models }}
| |> :: :: induces {{ tex \triangleright }}
| notin :: :: notin {{ tex \notin }}
| subset :: :: subset {{ tex \subseteq }}
| Id :: :: Id {{ tex \mathsf{Id} }}
| Sb :: :: Sb {{ tex \mathsf{Sb} }}

formula :: formula_ ::=
  {{ com formulas }}
| judgement :: :: judgement
| A [ a ] ( s ) = n :: M :: a_eval
  {{ hol (a_eval [[a]] [[s]] = [[n]]) }}
  {{ tex \mathcal{A}[\![ [[a]] ]\!]([[s]]) = [[n]] }}
| B [ b ] ( s ) = v :: M :: b_eval
  {{ hol (b_eval [[b]] [[s]] = [[v]]) }}
  {{ tex \mathcal{B}[\![ [[b]] ]\!]([[s]]) = [[v]] }}
| m { S } in Tab :: M :: proc_in_T
  {{ com procedure $m$ is declared with body $S$ in the procedure table $T$ }}
  {{ hol (ALOOKUP [[Tab]] [[m]] = SOME [[S]]) }}
| f |= E f' :: M :: entails
  {{ com entailment, as decided by the oracle $E$ }}
  {{ hol ([[E]] [[f]] [[f']]) }}
  {{ tex [[f]] \models [[f']] }}
| Y : f in G :: M :: in_G
  {{ hol (([[Y]],[[f]]) IN [[G]]) }}
| Y notin dom ( G ) :: M :: notin_dom
  {{ hol ([[Y]] NOTIN G_dom [[G]]) }}
  {{ tex [[Y]] \notin \mathrm{dom}([[G]]) }}
| Y in dom ( G ) :: M :: in_dom
  {{ hol ([[Y]] IN G_dom [[G]]) }}
  {{ tex [[Y]] \in \mathrm{dom}([[G]]) }}
| dom ( G ) = dom ( G' ) :: M :: dom_eq
  {{ hol (G_dom [[G]] = G_dom [[G']]) }}
  {{ tex \mathrm{dom}([[G]]) = \mathrm{dom}([[G']]) }}
| G subset G' :: M :: subset
  {{ hol ([[G]] SUBSET [[G']]) }}
| Y = m :: M :: Y_eq_m
  {{ com $Y$ is the statement variable $Y_m$ associated with procedure $m$ }}
  {{ hol ([[Y]] = [[m]]) }}
| closed ( f ) :: M :: closed
  {{ hol (fv_f [[f]] = []) }}
  {{ tex [[f]]\ \mathrm{closed} }}

substitutions
  single f X :: subst

freevars
  f X :: fv

embed
{{ hol

Definition a_eval_def:
  (a_eval (a_num n) s = n) /\
  (a_eval (a_var x) s = s x) /\
  (a_eval (a_uminus a) s = - a_eval a s) /\
  (a_eval (a_plus a1 a2) s = a_eval a1 s + a_eval a2 s) /\
  (a_eval (a_minus a1 a2) s = a_eval a1 s - a_eval a2 s) /\
  (a_eval (a_times a1 a2) s = a_eval a1 s * a_eval a2 s)
End

Definition b_eval_def:
  (b_eval b_true s = T) /\
  (b_eval b_false s = F) /\
  (b_eval (b_eq a1 a2) s = (a_eval a1 s = a_eval a2 s)) /\
  (b_eval (b_leq a1 a2) s = (a_eval a1 s <= a_eval a2 s)) /\
  (b_eval (b_neg b) s = ~b_eval b s) /\
  (b_eval (b_and b1 b2) s = (b_eval b1 s /\ b_eval b2 s))
End

(* replace each call m() with skip;Y_m where Y_m = m is in ms *)
Definition subst_calls_def:
  (subst_calls ms S_skip = S_skip) /\
  (subst_calls ms (S_assign x a) = S_assign x a) /\
  (subst_calls ms (S_seq S1 S2) = S_seq (subst_calls ms S1) (subst_calls ms S2)) /\
  (subst_calls ms (S_ifelse b S1 S2) =
    S_ifelse b (subst_calls ms S1) (subst_calls ms S2)) /\
  (subst_calls ms (S_call m) =
    if m IN ms then S_seq S_skip (S_var m) else S_call m) /\
  (subst_calls ms (S_var Y) = S_var Y)
End

Definition G_dom_def:
  G_dom (G : (string # f) set) = IMAGE FST G
End
}}

defns
  sos_defs :: '' ::=

defn
  Tab |- c => c' :: :: c_red :: sos_
  {{ com structural operational semantics (Figure 1) }}
  {{ tex [[c]] \Rightarrow [[c']] }}
by

---------------- :: skip
Tab |- <<skip,s>> => s

A[a](s) = n
------------------------------ :: assign
Tab |- <<x := a, s>> => s[x |-> n]

Tab |- <<S1,s>> => s'
------------------------------ :: seq1
Tab |- <<S1;S2,s>> => <<S2,s'>>

Tab |- <<S1,s>> => <<S'1,s'>>
---------------------------------- :: seq2
Tab |- <<S1;S2,s>> => <<S'1;S2,s'>>

B[b](s) = tt
--------------------------------------------- :: if1
Tab |- <<if b then S1 else S2, s>> => <<S1,s>>

B[b](s) = ff
--------------------------------------------- :: if2
Tab |- <<if b then S1 else S2, s>> => <<S2,s>>

m{S} in Tab
------------------------- :: call
Tab |- <<m(),s>> => <<S,s>>

defn
  Tab |- S |> t :: :: sos_tr :: sos_tr_
  {{ com finite traces induced by the SOS (Definition 2.6) }}
  {{ tex [[t]] \in \mathcal{S}_{sos}[\![ [[S]] ]\!] }}
by

Tab |- <<S,s>> => s'
------------------ :: end
Tab |- S |> s . s'

Tab |- <<S,s>> => <<S',s'>>
Tab |- S' |> s' . t
------------------------- :: step
Tab |- S |> s . s' . t

defns
  calc_defs :: '' ::=

defn
  Tab ; E ; G |- S : f :: :: calc :: calc_
  {{ com proof calculus (Figure 5, plus explicit structural rules) }}
  {{ tex [[G]] \vdash [[S]] : [[f]] }}
by

----------------------- :: skip
Tab ; E ; G |- skip : Id

----------------------------------- :: assign
Tab ; E ; G |- x := a : Sb [ a , x ]

Tab ; E ; G |- S1 : f1
Tab ; E ; G |- S2 : f2
------------------------------ :: seq
Tab ; E ; G |- S1 ; S2 : f1 ^ f2

Tab ; E ; G |- skip;S1 : ~b \/ f
Tab ; E ; G |- skip;S2 : b \/ f
------------------------------------- :: if
Tab ; E ; G |- if b then S1 else S2 : f

closed(mu X.f)
Tab ; E ; G |- S : f[mu X.f/X]
---------------------------- :: unfold
Tab ; E ; G |- S : mu X.f

Tab ; E ; G |- S : f'
f' |= E f
------------------ :: cons
Tab ; E ; G |- S : f

m{S} in Tab
Y = m
Y notin dom(G)
Tab ; E ; G, Y : f |- S[G, Y : f] : f
----------------------------------- :: call
Tab ; E ; G |- m() : Id ^ f

Y : f in G
------------------ :: ax
Tab ; E ; G |- Y : f

Tab ; E ; G |- S : f
G subset G'
dom(G) = dom(G')
------------------- :: weak
Tab ; E ; G' |- S : f

Y in dom(G)
Tab ; E ; G |- Y : f'
Tab ; E ; G, Y : f' |- S : f
-------------------------- :: cut
Tab ; E ; G |- S : f

Tab ; E ; G |- S : f1
Tab ; E ; G |- S : f2
------------------------ :: andR
Tab ; E ; G |- S : f1 /\ f2

Tab ; E ; G, Y : f1, Y : f2 |- S : f
---------------------------------- :: andL
Tab ; E ; G, Y : f1 /\ f2 |- S : f

Tab ; E ; G, Y : f |- S : f''
f' |= E f
---------------------------- :: consL
Tab ; E ; G, Y : f' |- S : f''
